# Copy to .env and fill in. NEVER commit .env.

# Web honeypot
# Set to 1 only for local development. The Werkzeug debugger allows remote
# code execution, so never enable it on a machine reachable by attackers.
HONEYSCOPE_DEBUG=0

# Difficulty of lab scenarios: low (default, original honeypot) | medium | high | impossible
HONEYSCOPE_LEVEL=low

# Wazuh / AI analyser (planned: ai_analysis/analyze.py)
INDEXER_USER=admin
INDEXER_PASSWORD=
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=
GEMINI_API_KEY=

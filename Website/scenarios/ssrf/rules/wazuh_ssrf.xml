<?xml version="1.0" encoding="UTF-8"?>
<!--
  HoneyScope Wazuh rules: ssrf scenario
  IDs 100510-100511 are the next free ones after jwt-flaws (100508-100509).
  MITRE: T1090 (Proxy)
-->
<group name="honeyscope,ssrf,">

  <!-- Rule 100510: SSRF to cloud-metadata or internal service -->
  <rule id="100510" level="12">
    <if_sid>31100</if_sid>
    <url>/api/fetch</url>
    <regex>(?i)(169\.254\.169\.254|internal-metadata|internal-api|0x7f|file://|dict://|gopher://|redirect-service)</regex>
    <description>HoneyScope ssrf: request to internal or cloud-metadata endpoint detected</description>
    <mitre>
      <id>T1090</id>
    </mitre>
    <group>ssrf,cloud_metadata,</group>
  </rule>

  <!-- Rule 100511: SSRF via scheme abuse or redirect attempt -->
  <rule id="100511" level="10">
    <if_sid>31100</if_sid>
    <url>/api/fetch</url>
    <regex>(?i)(ssrf|file://|dict://|gopher://|0x7f000001|127\.0\.0\.1|localhost)</regex>
    <description>HoneyScope ssrf: suspicious URL scheme or localhost SSRF attempt</description>
    <mitre>
      <id>T1090</id>
    </mitre>
    <group>ssrf,localhost_bypass,</group>
  </rule>

</group>

<?xml version="1.0" encoding="UTF-8"?>
<group name="honeyscope,graphql_abuse,">
  <rule id="100516" level="10">
    <if_sid>31100</if_sid>
    <url>/api/graphql</url>
    <regex>(?i)(__schema|__type|adminData)</regex>
    <description>HoneyScope graphql-abuse: introspection or sensitive field access attempt</description>
    <mitre><id>T1190</id></mitre>
    <group>graphql,reconnaissance,</group>
  </rule>
  <rule id="100517" level="12">
    <if_sid>31100</if_sid>
    <url>/api/graphql</url>
    <regex>(?i)(\[\s*\{\s*["']query["']|\b[a-z0-9_]+:\s*user)</regex>
    <description>HoneyScope graphql-abuse: batching or alias amplification attack</description>
    <mitre><id>T1190</id></mitre>
    <group>graphql,dos,bypass,</group>
  </rule>
</group>

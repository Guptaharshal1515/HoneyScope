<?xml version="1.0" encoding="UTF-8"?>
<group name="honeyscope,file_upload,">
  <rule id="100514" level="10">
    <if_sid>31100</if_sid>
    <url>/api/upload</url>
    <regex>(?i)(\.php|\.py|\.sh|\.exe|\.jsp|webshell)</regex>
    <description>HoneyScope file-upload: executable script upload attempt</description>
    <mitre><id>T1105</id></mitre>
    <group>upload,webshell,</group>
  </rule>
  <rule id="100515" level="12">
    <if_sid>31100</if_sid>
    <url>/api/upload</url>
    <regex>(?i)(Content-Type.*image.*php|shell\.php)</regex>
    <description>HoneyScope file-upload: spoofed content-type or double extension attempt</description>
    <mitre><id>T1105</id></mitre>
    <group>upload,webshell,</group>
  </rule>
</group>

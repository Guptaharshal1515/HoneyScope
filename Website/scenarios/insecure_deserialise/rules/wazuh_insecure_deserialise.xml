<?xml version="1.0" encoding="UTF-8"?>
<group name="honeyscope,insecure_deserialise,">
  <rule id="100518" level="10">
    <if_sid>31100</if_sid>
    <url>/api/deserialise</url>
    <regex>(?i)(cos\s+system|c__builtin__|rO0AB)</regex>
    <description>HoneyScope insecure-deserialise: binary stream or pickle gadget attempt</description>
    <mitre><id>T1059</id></mitre>
    <group>deserialization,rce,</group>
  </rule>
  <rule id="100519" level="12">
    <if_sid>31100</if_sid>
    <url>/api/deserialise</url>
    <regex>(?i)(__class__|SafeConfigGadget|deserialise)</regex>
    <description>HoneyScope insecure-deserialise: JSON class gadget injection attempt</description>
    <mitre><id>T1059</id></mitre>
    <group>deserialization,injection,</group>
  </rule>
</group>

<?xml version="1.0" encoding="UTF-8"?>
<group name="honeyscope,race_condition,">
  <rule id="100522" level="10">
    <if_sid>31100</if_sid>
    <url>/api/coupon</url>
    <regex>(?i)(PROMO50|SAVE50|coupon.*apply)</regex>
    <description>HoneyScope race-condition: high-value promo coupon application attempt</description>
    <mitre><id>T1499</id></mitre>
    <group>business_logic,coupon,</group>
  </rule>
  <rule id="100523" level="12">
    <if_sid>31100</if_sid>
    <url>/api/coupon</url>
    <regex>(?i)(double.*spend|race_condition|negative.*amount)</regex>
    <description>HoneyScope race-condition: double spending or concurrency abuse pattern</description>
    <mitre><id>T1499</id></mitre>
    <group>concurrency,abuse,</group>
  </rule>
</group>

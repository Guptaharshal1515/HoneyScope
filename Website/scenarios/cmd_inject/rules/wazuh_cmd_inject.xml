<?xml version="1.0" encoding="UTF-8"?>
<group name="honeyscope,cmd_inject,">
  <rule id="100520" level="10">
    <if_sid>31100</if_sid>
    <url>/api/</url>
    <regex>(?i)(;|(&amp;&amp;)|\|\||whoami|cat\s+/etc)</regex>
    <description>HoneyScope cmd-inject: command separator or reconnaissance command attempt</description>
    <mitre><id>T1059.004</id></mitre>
    <group>command_injection,rce,</group>
  </rule>
  <rule id="100521" level="12">
    <if_sid>31100</if_sid>
    <url>/api/</url>
    <regex>(?i)(/etc/passwd|/etc/shadow|\.\./|&lt;!ENTITY|SYSTEM\s+["']file)</regex>
    <description>HoneyScope cmd-inject: path traversal or XXE attempt</description>
    <mitre><id>T1059.004</id></mitre>
    <group>traversal,xxe,</group>
  </rule>
</group>
